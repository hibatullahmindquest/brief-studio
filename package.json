{
  "name": "brief-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "worker:interactive": "cross-env WORKER_LANE=interactive tsx src/worker/index.ts",
    "worker:background": "cross-env WORKER_LANE=background tsx src/worker/index.ts",
    "worker:restart": "powershell -NoProfile -File scripts/worker-restart.ps1",
    "lint": "eslint",
    "seed:m1": "tsx scripts/seed-m1.ts",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "bcrypt": "^6.0.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "openai": "^6.27.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "prisma": "^4.16.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
