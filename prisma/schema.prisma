// prisma/schema.prisma
// Run `npx prisma generate` after editing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  username  String   @unique
  teamRole  String   @default("marketing") // "marketing" | "creative"
  isAdmin   Boolean  @default(false)
  team      String   @default("single") // lens scope: "single" | "multi" (HOD) | "all" (admin)
  createdAt DateTime @default(now())
  stats          Stats?
  creativeRuns   CreativeRun[]
  notes          Note[]
  campaigns      Campaign[]
  calendarEvents CalendarEvent[]
  preference     UserPreference?
  apiUsageLogs   APIUsageLog[]
}

// store a snapshot of performance metrics created the first time a user logs in
model Stats {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique
  leadsThisWeek  Int
  revenue        Float
  avgCtr         Float
  postsPublished Int
  // brand onboarding data
  brandName       String?
  instagramHandle String?
  onboardingDone  Boolean  @default(false)
  // short marketing-style summary generated once when onboarding is completed
  summary         String?
  // quiz answers — used to derive accurate stats
  industry        String?   // e.g. "Fashion", "Fitness", "Food & Beverage"
  monthlyRevenue  Float?    // user's current monthly revenue in GBP
  adSpend         Float?    // monthly ad spend in GBP
  teamSize        String?   // "solo", "2-5", "6-20", "20+"
  mainGoal        String?   // "grow_followers", "increase_sales", "launch_product", "build_brand"
  // Instagram data stored for stats derivation
  igFollowers     Int?
  igPosts         Int?
  // Meta (Instagram) OAuth tokens for official Graph API
  igUserId        String?  // IG Business/Creator account user ID
  igAccessToken   String?  // long-lived page access token
  igTokenExpiry   DateTime?
  // Official Meta stats (refreshed via /api/instagram/stats)
  igImpressions   Int?
  igReach         Int?
  igProfileViews  Int?
  igWebsiteClicks Int?
  igEngagementRate Float?
  igAvgLikes      Float?
  igAvgComments   Float?
  createdAt       DateTime @default(now())
}

// One creative-journey run: input -> intent -> recipe -> artifacts. Renamed from
// FeatureRun (Module 1); @@map keeps the existing "FeatureRun" table -> zero data
// migration. Legacy columns (feature/inputJson/outputJson/feedback) kept for
// back-compat with the current visual-generation path; Module 1 fields added.
model CreativeRun {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  brand       Brand?   @relation(fields: [brandId], references: [id])
  brandId     String?
  recipe      Recipe?  @relation(fields: [recipeId], references: [id])
  recipeId    String?
  feature     String   // "poster" | "copy" | "storyboard" | "script" | "shooting_plan" | "ideas" | "plan" | "virality"
  subtype     String?
  title       String   @default("")
  inputJson   String?
  outputJson  String
  feedback    Int?     // 1 = thumbs up, -1 = thumbs down, null = no feedback
  feedbackNote String?
  status      String   @default("generated") // "draft" | "confirmed" | "generated" — visual-intake lifecycle
  // ── Module 1: creative-journey fields ──
  lens        String?  // "marketing" | "social" | "social_memo" — interpretation context
  inputText   String?  // raw describe/brief text
  inputUploads String[] @default([]) // uploaded asset paths/urls
  intent      String?  // classified task purpose
  spec        Json?    // structured brief filled after gap-check
  contextUsed Json?    // grounding slot — signals (M4) + Meta findings (M3), empty for now
  createdAt   DateTime @default(now())
  artifacts   Artifact[]

  @@map("FeatureRun")
  @@index([userId, feature, createdAt])
  @@index([userId, brandId, feature, createdAt])
  @@index([recipeId])
}

// A recipe = the pipeline for one task type: an ordered lineup of experts.
// Router picks a recipe; the recipe drives which experts run, in order.
model Recipe {
  id           String   @id @default(cuid())
  taskType     String   @unique // "poster" | "caption" | "marketing_plan" | ...
  group        String   @default("") // "creative" | "copy" | "strategy" | "intelligence" | "compound"
  steps        Json     @default("[]") // [{ roleKey, modelTier? }, ...] — ordered expert lineup
  outputFormat String   @default("") // "image" | "text" | "pdf" | "carousel"
  lenses       String[] @default([]) // lenses this recipe applies to
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creativeRuns CreativeRun[]
}

// An expert = an admin-editable system prompt run as one recipe step. Output
// off? Edit the prompt in admin, not the code. (Design calls this "Role / Expert".)
model Expert {
  id           String   @id @default(cuid())
  roleKey      String   @unique // "strategist" | "copywriter" | "art_director" | "social" | "brand_guardian"
  name         String
  systemPrompt String   @default("")
  modelTier    String   @default("standard") // "fast" | "standard" | "premium"
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One output of a run. A run can yield many artifacts (poster + caption, etc.).
// Replaces the single outputJson blob; also carries the 👍/👎 feedback signal.
model Artifact {
  id           String      @id @default(cuid())
  run          CreativeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId        String
  type         String      // "image" | "copy" | "caption" | "storyboard" | "script" | "plan" | "pdf"
  content      Json        @default("{}")
  exportFormat String      @default("") // "png" | "pdf" | "txt" | ...
  mediaPath    String?     // filesystem path for media artifacts (images/pdf)
  feedback     Int?        // 1 = thumbs up, -1 = thumbs down, null = none
  feedbackNote String?
  createdAt    DateTime    @default(now())

  @@index([runId, createdAt])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique // "SifuTutor" | "NakNgaji"
  slug        String   @unique // "sifututor" | "nakngaji"
  logoUrl     String?  // legacy single logo (fallback) — public/uploads/brand/<slug>-logo.png
  logoUrlLight String? // logo variant to stamp ON LIGHT backgrounds (dark-ink logo) — <slug>-logo-light.png
  logoUrlDark  String? // logo variant to stamp ON DARK backgrounds (light/white logo) — <slug>-logo-dark.png
  logoSize    String   @default("md") // poster logo size: "sm" | "md" | "lg"
  logoCorner  String   @default("tl") // poster logo corner: "tl" (kiri-atas) | "tr" (kanan-atas) | "tc" (tengah-atas)
  posterFooterLeft  String?  // poster overlay footer — left (e.g. © 2025 ...)
  posterFooterRight String?  // poster overlay footer — right (e.g. tagline)
  primaryColor    String   @default("#000000")
  secondaryColor  String   @default("#ffffff")
  tone        String   @default("professional")
  targetAudience  String   @default("")
  coreOffer   String   @default("")
  keyMessages String   @default("")
  dontSay     String   @default("")
  tagline     String   @default("")
  instagramHandle String?
  facebookHandle  String?
  tiktokHandle    String?
  isActive    Boolean  @default(true)
  // ── Module 1: enriched brand knowledge (grounding for expert pipeline) ──
  contentPillars      String[] @default([]) // core content themes
  audienceSegments    String[] @default([]) // distinct audience groups
  doNot               String[] @default([]) // structured do-not list (supersedes legacy dontSay)
  signaturePhrases    String[] @default([]) // brand voice phrases to favour
  religiousGuidelines String   @default("") // e.g. Islamic compliance notes (NakNgaji)
  logoPath            String?               // canonical logo asset (supersedes legacy logoUrl)
  footer              String?               // canonical overlay footer text
  colors              String[] @default([]) // brand palette (hex), beyond primary/secondary
  fonts               String[] @default([]) // brand font stack
  templates           Json     @default("[]") // structured brand templates (wired later)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creativeRuns CreativeRun[]
  metaConnections MetaConnection[]
  organicPosts    OrganicPost[]
  adCreatives     AdCreative[]
  adDailyMetrics  AdDailyMetric[]
  dailySignals    DailySignal[]
  reports         Report[]
}

// ── SCIS: Meta integration + analytics ──────────────────────────────

model MetaConnection {
  id           String    @id @default(cuid())
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  type         String    // "page" | "instagram" | "ad_account"
  externalId   String    // page_id | ig_user_id | ad_account_id (act_ prefix kept)
  name         String    @default("")
  tokenEnc     String?   // AES-256-GCM encrypted token (see lib/crypto)
  tokenExpiry  DateTime?
  scopes       String    @default("")
  status       String    @default("connected") // connected | needs_reauth | not_linked | error
  lastError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([brandId, type, externalId])
  @@index([brandId, type])
}

model OrganicPost {
  id           String    @id @default(cuid())
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  platform     String    // "facebook" | "instagram"
  metaPostId   String
  type         String    @default("") // image | video | carousel | reel | story
  caption      String    @default("")
  thumbnailUrl String?
  permalink    String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  snapshots    OrganicMetricSnapshot[]

  @@unique([brandId, metaPostId])
  @@index([brandId, platform, publishedAt])
}

model OrganicMetricSnapshot {
  id             String   @id @default(cuid())
  post           OrganicPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String
  dateRange      String   // "t1" | "t7" | "t30"
  reach          Int      @default(0)
  impressions    Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  saves          Int      @default(0)
  profileActions Int      @default(0)
  engagementRate Float    @default(0)
  score          Float    @default(0)
  metricsJson    String?  // raw extras (stringified JSON)
  syncedAt       DateTime @default(now())

  @@unique([postId, dateRange])
  @@index([postId, dateRange])
}

model AdCreative {
  id           String   @id @default(cuid())
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  metaAdId     String
  campaignId   String   @default("")
  adsetId      String   @default("")
  name         String   @default("")
  copyJson     String?  // stringified JSON
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  snapshots    AdMetricSnapshot[]
  dailyMetrics AdDailyMetric[]

  @@unique([brandId, metaAdId])
  @@index([brandId, campaignId])
}

model AdMetricSnapshot {
  id          String   @id @default(cuid())
  ad          AdCreative @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId        String
  dateRange   String   // "t1" | "t7" | "t30"
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  results     Int      @default(0) // leads/conversions
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  cpl         Float    @default(0)
  frequency   Float    @default(0)
  metricsJson String?  // stringified JSON
  syncedAt    DateTime @default(now())

  @@unique([adId, dateRange])
  @@index([adId, dateRange])
}

// Daily-grain paid metrics — the source of truth for paid analytics.
// T-1/T-7/T-30 windows are rolled up from these rows (not stored as fixed
// snapshots). Mirrors the rich schema imported from marketing-ai-agent.
model AdDailyMetric {
  id              String   @id @default(cuid())
  ad              AdCreative @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId            String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  metricDate      DateTime @db.Date
  spend           Float    @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  clicks          Int      @default(0)
  linkClicks      Int      @default(0)
  leads           Int      @default(0)
  waConversations Int      @default(0)
  ctr             Float    @default(0)  // ctr_pct
  cpc             Float    @default(0)
  cpm             Float    @default(0)
  cpl             Float    @default(0)
  frequency       Float    @default(0)
  campaignId      String   @default("")
  campaignName    String   @default("")
  adsetName       String   @default("")
  objective       String   @default("")
  effectiveStatus String   @default("")
  metricsJson     String?  // breakdowns: country, placement, age_range, segment, ad_format, etc.
  syncedAt        DateTime @default(now())

  @@unique([adId, metricDate])
  @@index([brandId, metricDate])
  @@index([adId, metricDate])
}

model DailySignal {
  id               String   @id @default(cuid())
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId          String
  channel          String   // "organic" | "paid"
  signalType       String
  decisionLabel    String   // scale_similar | create_variation | watch | hold_stop
  confidence       String   @default("low") // low | medium | high
  score            Float    @default(0)
  evidenceJson     String   @default("[]") // stringified JSON array
  recommendation   String   @default("")
  suggestedActions String   @default("[]") // stringified JSON array
  generatedAt      DateTime @default(now())

  @@index([brandId, channel, generatedAt])
}

model Report {
  id          String   @id @default(cuid())
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  periodType  String   // "daily" | "weekly" | "monthly"
  periodStart DateTime
  periodEnd   DateTime
  dataJson    String   // stringified JSON payload used for the narrative
  narrative   String   @default("")
  exportPath  String?
  createdAt   DateTime @default(now())

  @@index([brandId, periodType, periodStart])
}

// AI usage + cost tracking — one row per gpt-4o / gpt-image call.
model APIUsageLog {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  brandId      String?
  featureRunId String?
  module       String   // "visual" | "copy"
  model        String   // "gpt-4o" | "gpt-5" | "gpt-image-2"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  imageCount   Int      @default(0)
  imageSize    String   @default("")
  costUsd      Float    @default(0)
  costMyr      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([brandId, module, createdAt])
}

// Persistent error capture — one row per logged failure (esp. OpenAI calls).
model ErrorLog {
  id           String   @id @default(cuid())
  source       String   // "visual.render" | "generate.copy" | "meta.callback" | ...
  level        String   @default("error") // "error" | "warn"
  message      String
  code         String   @default("")
  httpStatus   Int?
  detail       String   @default("") // stack + extracted OpenAI body, capped
  userId       String?
  brandId      String?
  featureRunId String?
  contextJson  String?  // sanitized JSON — never secrets
  createdAt    DateTime @default(now())

  @@index([source, createdAt])
  @@index([level, createdAt])
}

// Async visual generation jobs — the queue between the web app (enqueue) and
// the worker process (claim → run OpenAI → persist). Tracks PROCESS only; the
// actual image stays in FeatureRun.outputJson. Loose featureRunId (no FK),
// matching APIUsageLog/ErrorLog convention.
model Job {
  id           String    @id @default(cuid())
  kind         String    @default("generate")     // generate | meta_sync | analyze | video | signal | export
  lane         String    @default("interactive")  // interactive | background
  payload      Json      @default("{}")
  dedupeKey    String?                              // active-job dedup (e.g. featureRunId, "meta_sync:<acc>:<date>")
  status       String    @default("queued")        // queued | processing | succeeded | failed
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledAt  DateTime?                            // eligible when null OR <= now (delay + backoff)
  claimedAt    DateTime?
  resultKind   String    @default("")              // kept for visual poll back-compat ("image"|"skipped")
  result       Json?                                // generic richer result for non-visual kinds
  costMyr      Float     @default(0)
  reason       String?
  retryable    Boolean   @default(true)
  featureRunId String?                              // visual jobs only (was required)
  userId       String?                              // null for system jobs (meta_sync)
  brandId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("GenerationJob")                            // keep the existing table — no data migration
  @@index([lane, status, scheduledAt])
  @@index([dedupeKey])
  @@index([featureRunId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String   @default("")
  body      String   @default("")
  colour    String   @default("zinc")
  tag       String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned, updatedAt])
}

model Campaign {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  channel   String
  stage     String
  budget    String   @default("")
  roi       String   @default("")
  goal      String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, stage, updatedAt])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  day       String
  month     Int
  year      Int
  title     String
  time      String
  type      String
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, year, month, day, time])
}

model UserPreference {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  brandName   String?
  defaultTone String   @default("Bold")
  coreOffer   String   @default("AI-powered social media copy system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
