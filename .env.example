# Database (PostgreSQL — KVM8 local)
DATABASE_URL="postgresql://user:password@localhost:5432/brief_studio"

# Auth (32+ characters random string)
SESSION_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# Meta / Instagram OAuth (optional — for brand Instagram integration)
META_APP_ID=""
META_APP_SECRET=""
# Graph API version (pinned)
META_GRAPH_VERSION="v21.0"
# OAuth redirect — must match the URI registered in the Meta App dashboard
META_REDIRECT_URI="http://localhost:3000/api/meta/callback"
# Encryption key for Meta tokens at rest — base64 of 32 bytes.
# Generate: openssl rand -base64 32   (required before connecting Meta)
META_TOKEN_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
