# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite database files
prisma/*.db
prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude harness — override global gitignore (.claude/ excluded globally, include project harness)
!.claude/
!.claude/**
.claude/settings.local.json

# local-only skill packs (installed via `skills add`) — keep on disk, out of git.
# Project skills (bs-*) stay tracked; external packs (Matt Pocock etc.) are local.
skills-lock.json
.claude/skills/*
!.claude/skills/bs-*/

# Generated images (created at runtime)
/public/uploads/generated/*
!/public/uploads/generated/.gitkeep

# Uploaded brand furniture (logos uploaded via admin at runtime)
/public/uploads/brand/*
!/public/uploads/brand/.gitkeep

# Exported PDFs (created at runtime — Phase F)
/public/uploads/exports/*
!/public/uploads/exports/.gitkeep

# Uploaded brief attachments (uploaded via Studio front door at runtime — Phase G)
/public/uploads/briefs/*
!/public/uploads/briefs/.gitkeep

# Generated status report PDFs (local artifacts — keep the README)
/docs/reports/*.pdf
